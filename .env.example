# Copy to .env and edit. (For docker compose keep it next to docker-compose.yml; for "node server.js" put it inside server/)
PORT=8080
# Where companies, users and daily backups are stored
DATA_DIR=./data
# First admin account (used only on the very first start). Leave ADMIN_PASSWORD empty and a random one is written to DATA_DIR/FIRST-ADMIN-PASSWORD.txt
ADMIN_USER=admin
ADMIN_PASSWORD=
# Set to 1 when running behind Caddy/Nginx/Cloudflare (HTTPS in front) so client IPs and secure cookies are right
TRUST_PROXY=0
COOKIE_SECURE=0
# Largest upload (backup restore / 2B / bank file) in MB
MAX_BODY_MB=60
